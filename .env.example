# --- Required ---

# Postgres connection string (Vercel Postgres or Supabase).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Password for the /office admin route.
ADMIN_PASSWORD=

# --- Email (Resend) ---
# Without a key, emails are logged to the server console and the buyer
# verification code is shown in the UI (non-production only).
RESEND_API_KEY=
EMAIL_FROM="The Office of John Heffron <office@yourdomain.com>"

# Where new requests/offers are sent (John).
BOOKING_NOTIFY_EMAIL=
# Where accepted deal sheets are sent (Peter). Falls back to BOOKING_NOTIFY_EMAIL.
PETER_EMAIL=

# --- Google Calendar (held dates, read-only) ---
# The calendar to sync. Use a service account (share the calendar with its
# client_email) OR an API key if the calendar is public. Without either,
# only app-accepted engagements show as HELD.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_API_KEY=

# --- Google Maps Distance Matrix (drive time from home base) ---
# Without a key, every date is quoted on fly terms.
GOOGLE_MAPS_API_KEY=

# --- Optional ---
# Used in deep links in email. Defaults to the Vercel deployment URL.
APP_URL=
# Cookie-signing secret. Defaults to ADMIN_PASSWORD.
SESSION_SECRET=
